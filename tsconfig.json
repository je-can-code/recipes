{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [ "bun-types" ]
  },
  "include": [ "web/src", "web/test", "scripts", "vite.config.ts", "vitest.config.ts" ],

  // the service worker runs without a page, so it's checked against the worker's globals instead of the
  // page's, by tsconfig.worker.json. The two sets can't be loaded together.
  "exclude": [ "web/src/worker/sw.ts" ]
}
