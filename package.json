{
  "name": "recipes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run typecheck && bunx --bun vite build && bun scripts/build-worker.ts && cd server && go build -o ../bin/recipes ./cmd/recipes",
    "start": "./bin/recipes",
    "deploy": "bun run build && systemctl --user restart recipes",
    "check": "cd server && go run ./cmd/recipes check -config ../config.yaml",
    "certs": "cd server && go run ./cmd/recipes certs -config ../config.yaml",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun run test:web && bun run test:server",
    "test:web": "vitest run",
    "test:server": "cd server && go test ./..."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.2"
  }
}
