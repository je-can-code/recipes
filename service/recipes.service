# The recipes website, always on: it starts with the desktop, runs as you, and needs no login.
#
# Install it by copying, not linking. A link would point into /mnt/exdrive, and if that drive mounted after
# systemd went looking at boot, the service would quietly never start.
#
#   cp service/recipes.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now recipes
#
# It never stops retrying. If the drive is late to mount, or port 80 isn't allowed yet, it tries again
# every five seconds until it can listen, rather than giving up after a few attempts.

[Unit]
Description=Recipes website
StartLimitIntervalSec=0

[Service]
ExecStart=/mnt/exdrive/dev/recipes/bin/recipes -config /mnt/exdrive/dev/recipes/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
